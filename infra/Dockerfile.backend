FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg liblouis-bin ca-certificates \
    && ffmpeg -version \
    && ffmpeg -hide_banner -filters 2>&1 | grep -Eq ' subtitles +V->V' \
    && ffprobe -version \
    && lou_translate --version \
    && printf 'Accessibility is a right.\n' | lou_translate unicode.dis,en-ueb-g2.ctb >/dev/null \
    && printf 'Accessibility is a right.\n' | lou_translate en-us-brf.dis,en-ueb-g2.ctb >/dev/null \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./app

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers"]
